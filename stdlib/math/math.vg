// ===== Complex Numbers (helper) =====

struct Complex {
    let real: Float
    let imag: Float
}

// Create complex number
public fn complex(real: Float, imag: Float) -> Complex {
    Complex(real, imag)
}

// Add two complex numbers
public fn add(c1: Complex, c2: Complex) -> Complex {
    Complex(c1.real + c2.real, c1.imag + c2.imag)
}

// Subtract two complex numbers
public fn subtract(c1: Complex, c2: Complex) -> Complex {
    Complex(c1.real - c2.real, c1.imag - c2.imag)
}

// Multiply two complex numbers
public fn multiply(c1: Complex, c2: Complex) -> Complex {
    let real = c1.real * c2.real - c1.imag * c2.imag
    let imag = c1.real * c2.imag + c1.imag * c2.real
    Complex(real, imag)
}

// Magnitude of complex number
public fn magnitude(c: Complex) -> Float {
    sqrt(c.real * c.real + c.imag * c.imag)
}
