// Random integer between 0 (inclusive) and max (exclusive)
public fn randomInt(max: Int) -> Int {
    // Java: new java.util.Random().nextInt(max)
}

// Random integer between min (inclusive) and max (exclusive)
public fn randomInt(min: Int, max: Int) -> Int {
    // Java: min + new java.util.Random().nextInt(max - min)
}

// Random float between min (inclusive) and max (exclusive)
public fn randomFloat(min: Float, max: Float) -> Float {
    // Java: min + (float) Math.random() * (max - min)
}

