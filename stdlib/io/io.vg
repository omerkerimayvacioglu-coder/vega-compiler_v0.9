// Vega Standard Library - IO Module
// Provides console I/O and file operations wrapping Java APIs

package stdlib.io

// ===== Console Output =====

// Print a string followed by newline
public fn println(msg: String) {
    // This will be compiled to: System.out.println(msg)
    // Java: System.out.println(msg);
}

// Print a string without newline
public fn print(msg: String) {
    // Java: System.out.print(msg);
}

