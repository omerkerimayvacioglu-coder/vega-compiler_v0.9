// ===== Map Operations =====

struct Map<K, V> {
    // Internal wrapper for java.util.HashMap
    let data: Any // Java: java.util.HashMap<K, V>
}

// Create empty map
public fn map<K, V>() -> Map<K, V> {
    // Java: new java.util.HashMap<K, V>()
}

// Put key-value pair
public fn put<K, V>(m: Map<K, V>, key: K, value: V) {
    // Java: m.put(key, value)
}

// Get value by key
public fn get<K, V>(m: Map<K, V>, key: K) -> V? {
    // Java: return m.get(key) // returns null if not found
}

// Check if map contains key
public fn containsKey<K, V>(m: Map<K, V>, key: K) -> Bool {
    // Java: m.containsKey(key)
}

// Check if map contains value
public fn containsValue<K, V>(m: Map<K, V>, value: V) -> Bool {
    // Java: m.containsValue(value)
}

// Remove key from map
public fn remove<K, V>(m: Map<K, V>, key: K) -> V? {
    // Java: m.remove(key)
}

// Get all keys
public fn keys<K, V>(m: Map<K, V>) -> Array<K> {
    // Java: m.keySet().toArray()
}

// Get all values
public fn values<K, V>(m: Map<K, V>) -> Array<V> {
    // Java: m.values().toArray()
}

// Get number of entries
public fn size<K, V>(m: Map<K, V>) -> Int {
    // Java: m.size()
}

// Clear all entries
public fn clear<K, V>(m: Map<K, V>) {
    // Java: m.clear()
}

